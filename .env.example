# Copy to .env and fill in once your accounts exist. Tests/dev work with USE_MOCKS=true.

USE_MOCKS=true

# --- MongoDB Atlas (Phase 3) ---
# ATLAS_URI=mongodb+srv://user:pass@cluster.xxxx.mongodb.net
DB_NAME=faultaudit

# --- Google Cloud / Vertex AI (Phase 3) ---
# GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GEMINI_MODEL=gemini-3-pro
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# Run the agent on Vertex AI (Agent Builder), not the public Gemini API:
GOOGLE_GENAI_USE_VERTEXAI=TRUE
